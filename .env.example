# Database Configuration
DB_PASSWORD=your_database_password_here
DB_USER=sa
DB_SERVER=sqlserver
DB_PORT=1433

# RabbitMQ Configuration
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=your_rabbitmq_password_here
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/

# Elasticsearch Configuration
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200

# Service URLs (Internal Docker Network)
ACCOUNT_SERVICE_URL=http://account-service-backend:5001
OFFER_SERVICE_URL=http://offer-service-backend:5002
PURCHASE_SERVICE_URL=http://purchase-service-backend:5004
SEARCH_SERVICE_URL=http://search-service-backend:5003
TRANSPORT_SERVICE_URL=http://transport-service-backend:5005

# Frontend API URLs (External Access)
REACT_APP_ACCOUNT_API_URL=http://localhost:5001/api
REACT_APP_OFFER_API_URL=http://localhost:5002/api
REACT_APP_PURCHASE_API_URL=http://localhost:5004/api
REACT_APP_SEARCH_API_URL=http://localhost:5003/api
REACT_APP_TRANSPORT_API_URL=http://localhost:5005/api

# Exchange Names
SEARCH_EXCHANGE_NAME=search_exchange